# ============================================================
#  متغيرات البيئة — انسخ هذا الملف إلى .env وضع القيم الحقيقية
# ============================================================

# --- Prisma / PostgreSQL (من Supabase → Project Settings → Database) ---
# للتطبيق (serverless) عبر الـ pooler، المنفذ 6543
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# للـ migrations فقط — اتصال مباشر، المنفذ 5432
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase (من Project Settings → API) ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGci..."          # المفتاح العام (للفرونت)
SUPABASE_SERVICE_KEY="eyJhbGci..."        # سري — للباك فقط، لا يُكشف للعميل أبداً
